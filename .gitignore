# =============================================================================
# Library Management System — .gitignore
# =============================================================================

# ----- Environment / Secrets -------------------------------------------------
# Never upload real credentials to GitHub
.env
.env.local
.env.production
.env.*.local

# Keep the safe placeholder template
!.env.example

# ----- Node dependencies (auto-reinstalled via npm install) ------------------
node_modules/
server/node_modules/
client/node_modules/

# ----- Build output ----------------------------------------------------------
client/dist/
client/build/

# ----- OS / Editor junk ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.user

# ----- IDE config (optional — keep if you want teammates to share settings) --
.vscode/
.idea/

# ----- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ----- Runtime / temp --------------------------------------------------------
pids/
*.pid
*.seed
*.pid.lock
.npm
.node_repl_history

# ----- One-time utility scripts (not part of the app) ------------------------
server/seed-books.js
server/update_isbn.js
